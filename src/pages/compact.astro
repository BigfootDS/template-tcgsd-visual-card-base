---
import '../styles/style.css';
---
<article class="example-vct">
  <header><h1>tcgsd:name</h1><p>tcgsd:containingSet · tcgsd:sortNumber</p></header>
  <p>tcgsd:types · tcgsd:resourceTypes</p>
  <section data-tcgsd-each="actions"><h2>tcgsd:item.name <span data-tcgsd-if="item.damage">tcgsd:item.damage</span></h2><p>tcgsd:item.description</p><p data-tcgsd-each="item.costs">tcgsd:item.quantity × tcgsd:item.resourceType</p></section>
  <dl class="card-data"><div data-tcgsd-each="propertyEntries"><dt>tcgsd:item.label</dt><dd>tcgsd:item.value tcgsd:item.unit</dd></div></dl>
  <p>tcgsd:flavourText</p>
</article>
